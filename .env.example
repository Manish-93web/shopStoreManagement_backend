# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Public base URL of this API server, used to build links in emails (e.g. generated report downloads)
APP_URL=http://localhost:5000

# --- Database ---
MONGODB_URI=

# --- Redis (set SKIP_REDIS=true to run without Redis in local dev) ---
REDIS_URL=redis://localhost:6379
SKIP_REDIS=false

# --- Auth ---
JWT_SECRET=
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=7d

# --- Payment gateways (optional — subscription checkout returns a clear
#     "not configured" error until these are set, it never fakes success) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEB_HOOK_SECRET=

# --- Email (SMTP) — optional, same honest-failure behavior when unset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (Twilio) — optional ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- WhatsApp (Twilio WhatsApp API) — optional ---
TWILIO_WHATSAPP_NUMBER=

# --- Image uploads (Cloudinary) — optional, falls back to base64 storage when unset ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Off-server backup storage (AWS S3) — optional, falls back to local disk when unset ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# --- Monitoring (Sentry) — optional ---
SENTRY_DSN=
